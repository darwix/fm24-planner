{
  "name": "fm-squad-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "start": "cargo run --locked -p fm-squad-planner --bin fm-squad-planner-server -- --no-open",
    "test": "cargo test --locked -p fm-squad-planner",
    "test:parity": "node scripts/parity.mjs",
    "build:web": "npm --prefix web run build",
    "build": "cargo build --release --locked -p fm-squad-planner",
    "desktop": "tauri dev",
    "build:desktop": "tauri build",
    "inspect": "cargo run --release --locked --example parse-save --"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
